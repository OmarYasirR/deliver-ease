NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/delivery_logistics

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=dls_token

# Frontend origin (for CORS + cookies)
CLIENT_URL=http://localhost:5173

# OSRM routing (real driving routes/distance). Defaults to the public demo
# server if unset — fine for dev, but self-host or use a paid provider in prod:
# https://project-osrm.org/docs/v5.24.0/api/#general-options
OSRM_BASE_URL=https://router.project-osrm.org

# Address autocomplete (Photon / OpenStreetMap) - free, no API key.
# The public instance is fair-use; self-host Photon for production: https://github.com/komoot/photon
GEOCODER_URL=https://photon.komoot.io

# Initial admin account created by `npm run seed:admin` (the script can also take --email/--password flags).
# Use a strong password, and change it after your first login.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_strong_password

