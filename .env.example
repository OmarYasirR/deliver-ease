# =====================================================================
# DeliverEase - environment variables reference
# Copy the BACKEND block into  backend/.env
# Copy the FRONTEND block into frontend/.env
# Never commit real .env files or secrets.
# =====================================================================

# ---------------------------- BACKEND --------------------------------
NODE_ENV=development
PORT=5000

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/delivery_logistics

# JWT / cookie auth - use a long random secret in production
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=dls_token

# Frontend origin (CORS + cookies)
CLIENT_URL=http://localhost:5173

# OSRM routing server (public demo is for development only; self-host in production)
OSRM_BASE_URL=https://router.project-osrm.org

# Address autocomplete - Photon/OpenStreetMap (free, no API key; self-host for production)
GEOCODER_URL=https://photon.komoot.io

# Initial admin account created by `npm run seed:admin` (the script can also take --email/--password flags).
# Use a strong password, and change it after your first login.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_strong_password


# ---------------------------- FRONTEND -------------------------------
# Backend REST API base URL
VITE_API_URL=http://localhost:5000/api

# Socket.IO server URL (same host/port as the API, without /api)
VITE_SOCKET_URL=http://localhost:5000
